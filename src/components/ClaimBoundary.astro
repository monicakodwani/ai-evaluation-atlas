---
/**
 * The unjustified-claims block inside an entry's Evidence Boundaries
 * section — visually the strongest element on the page.
 */
interface Props {
  claims: string[];
}

const { claims } = Astro.props;
---

<div class="claim-boundary eb-block">
  <h3>Claims it cannot support</h3>
  {
    claims.length > 0 ? (
      <ul class="claim-list">
        {claims.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
    ) : (
      <p>
        The claim boundary for this entry has not been drafted yet — a
        defining section of every completed Atlas entry.
      </p>
    )
  }
</div>
