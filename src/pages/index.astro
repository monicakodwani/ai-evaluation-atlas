---
import AtlasLayout from '../layouts/AtlasLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import { LIFECYCLE_CONTENT } from '../data/lifecycle';
import { atlasUrl, getAllEntries } from '../lib/entries';
import {
  ATLAS_DESCRIPTION,
  ATLAS_NAME,
  ATLAS_SUBTITLE,
  ATLAS_VERSION,
} from '../config';

const all = await getAllEntries();
const featured = all.filter((ref) => ref.entry.data.featured).slice(0, 6);

const learningPath = [
  {
    title: 'What Counts as AI Evaluation?',
    href: atlasUrl('guides/what-counts-as-ai-evaluation/'),
    text: 'What "evaluation" now covers, why models are not systems, and why the right method depends on the claim.',
  },
  {
    title: 'Evaluation Is Measurement',
    href: atlasUrl('guides/evaluation-is-measurement/'),
    text: 'Constructs, reliability, validity, uncertainty — the toolkit for judging any evaluation result.',
  },
  {
    title: 'Reading an AI Evaluation Report',
    href: atlasUrl('guides/reading-an-ai-evaluation-report/'),
    text: 'Ten things to check in any paper, leaderboard, or system card — with a printable checklist.',
  },
  {
    title: 'The Taxonomy',
    href: atlasUrl('taxonomy/'),
    text: 'The conceptual map: evaluation objects, method families, and the five evidence classes.',
  },
];

const referenceCollections = [
  {
    title: 'Methods',
    href: atlasUrl('explore/?type=method'),
    text: 'Benchmarks, human evaluation, AI judges, red teaming, audits, monitoring, and other evaluation approaches.',
  },
  {
    title: 'Benchmarks and suites',
    href: atlasUrl('explore/?type=benchmark'),
    text: 'Instruments used to compare capabilities, risks, safety properties, agents, and deployed systems.',
  },
  {
    title: 'Standards and governance',
    href: atlasUrl('explore/?type=standard'),
    text: 'Formal standards, regulatory frameworks, assurance practices, documentation, and institutional evaluation.',
  },
  {
    title: 'Evaluation science',
    href: atlasUrl('explore/?type=concept'),
    text: 'Validity, reliability, uncertainty, contamination, reproducibility, and the limits of evaluation claims.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: ATLAS_NAME,
  description: ATLAS_DESCRIPTION,
  url: new URL(import.meta.env.BASE_URL, Astro.site).toString(),
  author: { '@type': 'Person', name: 'Monica Kodwani' },
};
---

<AtlasLayout description={ATLAS_DESCRIPTION} currentPath="">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />

  <div class="atlas-hero">
    <p class="kicker">An independent research project</p>
    <h1>AI Evaluation Atlas</h1>
    <p class="subheading">{ATLAS_SUBTITLE}</p>
    <p class="lede">
      Evaluation results now drive real decisions — what gets deployed,
      procured, regulated, and trusted. Yet scores are routinely asked to
      carry claims they cannot support. The Atlas teaches the reasoning:
      what each kind of evaluation actually measures, what evidence it
      produces, and what its results can and cannot establish.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={atlasUrl('how-to-use/')}>Start here</a>
      <a class="btn btn-secondary" href={atlasUrl('explore/')}
        >Explore the Atlas</a
      >
    </div>
  </div>

  <section aria-labelledby="proposition">
    <div class="editorial-callout">
      <p class="kicker" id="proposition">The Atlas’s central proposition</p>
      <p>
        A benchmark score is evidence about a defined task, scoring method,
        model configuration, and test population. It is not, by itself,
        evidence that a deployed system is safe, fair, reliable, or
        trustworthy.
      </p>
    </div>
  </section>

  <section aria-labelledby="purpose-heading">
    <div class="section-head">
      <h2 id="purpose-heading">Why this Atlas exists</h2>
    </div>
    <div class="purpose-grid">
      <div>
        <h3>The problem</h3>
        <p>
          AI evaluation has become a sprawl of benchmarks, judges, red
          teams, audits, and standards — each producing numbers that get
          quoted far beyond what they measure. The field's instruments have
          outrun its habits of interpretation.
        </p>
      </div>
      <div>
        <h3>Who it is for</h3>
        <p>
          Researchers, practitioners, policymakers, auditors, and students —
          anyone who has to produce an evaluation, or decide how much weight
          to put on someone else's.
        </p>
      </div>
      <div>
        <h3>What it does</h3>
        <p>
          It teaches the reasoning. Every entry separates what an instrument
          measures from what its results can support, corrects common
          misconceptions, surfaces live debates, and ends with the questions
          worth asking.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="learn-heading">
    <div class="section-head">
      <h2 id="learn-heading">Learn how evaluation works</h2>
      <a class="more-link" href={atlasUrl('how-to-use/')}
        >Full reading path →</a
      >
    </div>
    <p style="max-width: 46rem;">
      Four stops build the core of the Atlas's approach — from what
      evaluation is, to how to judge any evaluation you meet.
    </p>
    <ol class="path-steps">
      {
        learningPath.map((step) => (
          <li>
            <p class="step-title">
              <a href={step.href}>{step.title}</a>
            </p>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="lifecycle-heading">
    <div class="section-head">
      <h2 id="lifecycle-heading">The evaluation lifecycle</h2>
      <a class="more-link" href={atlasUrl('lifecycle/')}>Full lifecycle map →</a>
    </div>
    <p>
      Evaluation is not a single pre-release event. Each stage asks different
      questions and calls for different instruments.
    </p>
    <ol class="lifecycle-strip" style="margin-top: 1.1rem;">
      {
        LIFECYCLE_CONTENT.map((stage, i) => (
          <li>
            <a
              href={atlasUrl(`lifecycle/#${stage.id}`)}
              title={`Example methods: ${stage.strip.join(', ')}`}
            >
              {stage.title}
            </a>
            {i < LIFECYCLE_CONTENT.length - 1 && (
              <span class="arrow" aria-hidden="true">
                →
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  {
    featured.length > 0 && (
      <section aria-labelledby="featured-heading">
        <div class="section-head">
          <h2 id="featured-heading">The major methods</h2>
          <a class="more-link" href={atlasUrl('explore/?type=method')}>
            All methods →
          </a>
        </div>
        <p style="max-width: 46rem; margin-bottom: 1.1rem;">
          Six entries anchor the reference side of the Atlas — each with its
          evidence boundaries stated plainly.
        </p>
        <ul class="card-grid">
          {featured.map((ref) => (
            <EntryCard ref={ref} />
          ))}
        </ul>
      </section>
    )
  }

  <section aria-labelledby="collections-heading">
    <div class="section-head">
      <h2 id="collections-heading">Reference collections</h2>
      <a class="more-link" href={atlasUrl('explore/')}>All entries →</a>
    </div>
    <ul class="entry-points">
      {
        referenceCollections.map((p, i) => (
          <li class="entry-point">
            <p class="index-no">{String(i + 1).padStart(2, '0')}</p>
            <h3>
              <a href={p.href}>{p.title}</a>
            </h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="status-heading">
    <h2 class="visually-hidden" id="status-heading">Project status</h2>
    <div class="status-note">
      <p>
        <strong>Version {ATLAS_VERSION}.</strong> The Atlas is a living
        reference: evidence-informed, transparent about interpretation, and
        open to revision. Read the
        <a href={atlasUrl('editorial-philosophy/')}>editorial philosophy</a>,
        the <a href={atlasUrl('methodology/')}>methodology</a>, and the
        <a href={atlasUrl('changelog/')}>changelog</a>.
      </p>
    </div>
  </section>
</AtlasLayout>
