---
import AtlasHeader from '../components/AtlasHeader.astro';
import AtlasFooter from '../components/AtlasFooter.astro';
import { ATLAS_DESCRIPTION, TITLE_SUFFIX } from '../config';
import '../styles/atlas.css';

interface Props {
  /** Page title; the Atlas suffix is appended automatically. */
  title?: string;
  description?: string;
  /** Path of the current page relative to the Atlas base, e.g. 'explore/'. */
  currentPath?: string;
}

const { title, description = ATLAS_DESCRIPTION, currentPath = '' } = Astro.props;

const fullTitle = title ? `${title} — ${TITLE_SUFFIX}` : TITLE_SUFFIX;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/${currentPath}`, Astro.site);
const ogImage = new URL(`${base}/og/social-card.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Evaluation Atlas" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      /* Shared with the main site: mk-theme key, data-theme attribute. */
      (function () {
        try {
          var stored = window.localStorage.getItem('mk-theme');
          if (stored !== 'dark' && stored !== 'light') stored = '';
          var dark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (dark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <AtlasHeader currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <AtlasFooter />
  </body>
</html>
